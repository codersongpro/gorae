{
  "manifest_version": 3,
  "name": "고래곳간",
  "description": "수업에 필요한 도구를 모아, 나누고, 이어 쓰다. 선생님과 학생 모두 누군가 만든 도구를 바로 활용하고, 내 수업에 맞게 바꾸고, 동료와 함께 쌓아가는 웨일 사이드바.",
  "version": "0.1.0",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://codersongpro.github.io/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://class.whalespace.io/*",
    "https://teamboard.whalespace.io/*",
    "https://teamboard.whale.naver.com/*",
    "https://study.whaleon.naver.com/*"
  ],
  "sidebar_action": {
    "default_page": "sidebar.html",
    "default_title": "고래곳간",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" },
    "use_navigation_bar": false
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "sandbox": { "pages": ["sandbox.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'none'; img-src data:; object-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
