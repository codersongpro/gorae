    {
      "id": "sample-class-timer",
      "title": "교실 모래시계 타이머",
      "type": "html",
      "artifactType": "html",
      "domain": "lesson",
      "category": "classroom_tool",
      "subcategory": "timer",
      "estimatedMinutes": 5,
      "groupType": "teacher",
      "audience": [
        "teacher"
      ],
      "tags": [
        "타이머",
        "전체활동"
      ],
      "description": "활동 시간을 크게 보여 주는 교실용 타이머예요.",
      "author": "파도 고래 · 초등",
      "howToUse": "분을 고르고 시작을 누르면 남은 시간이 크게 보여요.",
      "promptRecipe": "전자칠판에 크게 보이는 수업용 타이머를 만들어 줘. 분을 고르고 시작·멈춤 버튼이 있어.",
      "version": 1,
      "addedAt": "2026-09-10T00:00:00Z",
      "html": "<!doctype html><html lang=\"ko\"><meta charset=\"utf-8\"><title>교실 타이머</title><body style=\"font-family:sans-serif;padding:12px\"><select id=\"m\"><option>1</option><option selected>3</option><option>5</option></select>분 <button id=\"s\">시작</button><p id=\"t\" style=\"font-size:48px\">03:00</p><script>let left=0,iv;const t=document.getElementById(\"t\");function draw(){t.textContent=String(Math.floor(left/60)).padStart(2,\"0\")+\":\"+String(left%60).padStart(2,\"0\")}document.getElementById(\"s\").onclick=()=>{clearInterval(iv);left=+document.getElementById(\"m\").value*60;draw();iv=setInterval(()=>{left=Math.max(0,left-1);draw();if(!left)clearInterval(iv)},1000)}</script></body></html>"
    },
    {
      "id": "sample-csv-summary",
      "title": "설문 CSV 응답 집계기",
      "type": "html",
      "artifactType": "html",
      "domain": "work",
      "category": "automation",
      "subcategory": "spreadsheet",
      "audience": [
        "teacher",
        "admin"
      ],
      "tags": [
        "자동화",
        "설문",
        "통계"
      ],
      "description": "설문 결과 CSV를 붙여 넣으면 문항별 응답 수를 세어 줘요. 데이터는 밖으로 나가지 않아요.",
      "author": "물결 고래 · 중등",
      "howToUse": "CSV 내용을 붙여 넣고 집계를 누르세요. 첫 줄은 문항 이름이어야 해요.",
      "promptRecipe": "CSV를 붙여 넣으면 열마다 값별 개수를 표로 보여 주는 집계 도구를 만들어 줘. 외부 전송 없이.",
      "version": 1,
      "addedAt": "2026-09-12T00:00:00Z",
      "html": "<!doctype html><html lang=\"ko\"><meta charset=\"utf-8\"><title>CSV 집계</title><body style=\"font-family:sans-serif;padding:12px\"><textarea id=\"c\" rows=\"6\" cols=\"40\" aria-label=\"CSV\"></textarea><br><button id=\"b\">집계</button><pre id=\"o\"></pre><script>document.getElementById(\"b\").onclick=()=>{const rows=document.getElementById(\"c\").value.trim().split(/\\n/).map(r=>r.split(\",\"));const head=rows.shift()||[];document.getElementById(\"o\").textContent=head.map((h,i)=>{const n={};rows.forEach(r=>{const v=(r[i]||\"\").trim();n[v]=(n[v]||0)+1});return h+\": \"+Object.entries(n).map(([k,v])=>k+\" \"+v).join(\", \")}).join(\"\\n\")}</script></body></html>"
    }
