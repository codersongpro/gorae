    "payload": "<!--gorae-card {\"type\":\"html\",\"artifactType\":\"html\",\"domain\":\"lesson\",\"version\":1,\"id\":\"share-peer-rubric\",\"title\":\"발표 동료평가 카드\",\"category\":\"assessment\",\"subcategory\":\"peer\",\"schoolLevel\":\"elementary\",\"grade\":\"5\",\"subject\":\"국어\",\"topic\":\"발표 듣고 평가하기\",\"estimatedMinutes\":5,\"groupType\":\"whole_class\",\"audience\":[\"student\"],\"tags\":[\"발표\",\"동료평가\"],\"author\":\"노을 고래\",\"description\":\"친구 발표를 듣고 별을 누르고, 좋은 점과 더 좋아질 점을 한 가지씩 쓰는 카드예요.\",\"howToUse\":\"항목마다 별을 누르고 한 줄씩 쓴 뒤 [평가 카드 만들기]를 눌러요.\",\"promptRecipe\":\"친구 발표를 평가하는 카드 만들어 줘. 별 3개 중에 고르고, 좋은 점이랑 더 좋아질 점을 쓰게 해 줘. 상처 주는 말 쓰지 말라는 안내도 넣어 줘.\",\"addedAt\":\"2026-09-30T00:00:00Z\"} -->\n<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>발표 동료평가 카드</title>\n<style>\n  :root { --b: #00788c; --tx: #171719; }\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 14px; background: #f7f7f8; color: var(--tx); font: 16px/1.5 \"Pretendard JP\", \"Malgun Gothic\", system-ui, sans-serif; word-break: keep-all; }\n  .wrap { max-width: 640px; margin: 0 auto; display: grid; gap: 12px; }\n  h1 { font-size: 1.25rem; margin: 0; } .sub { margin: 2px 0 0; color: #5a5c63; font-size: .9rem; }\n  .card { background: #fff; border-radius: 14px; padding: 14px; box-shadow: 0 1px 4px rgba(23,23,23,.08); display: grid; gap: 8px; }\n  .row { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 6px 0; border-bottom: 1px solid #eee; }\n  .stars { display: flex; gap: 2px; }\n  .stars button { min-width: 44px; min-height: 44px; font-size: 1.5rem; border: 0; background: transparent; cursor: pointer; filter: grayscale(1); opacity: .45; }\n  .stars button.on { filter: none; opacity: 1; }\n  .stars button:focus-visible, button:focus-visible, textarea:focus-visible { outline: 3px solid #5cc7da; outline-offset: 2px; }\n  textarea { width: 100%; min-height: 80px; font: inherit; padding: 10px; border: 1px solid #e1e2e4; border-radius: 10px; }\n  button.p { font: inherit; font-weight: 700; min-height: 46px; border: 0; border-radius: 12px; background: var(--b); color: #fff; cursor: pointer; }\n  #result { white-space: pre-wrap; background: #e6f6f9; border-radius: 10px; padding: 12px; display: none; }\n  .hint { color: #5a5c63; font-size: .85rem; margin: 0; }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header><h1>⭐ 발표 동료평가 카드</h1><p class=\"sub\">친구 발표를 보고 별을 눌러요. 평가는 이 화면 안에서만 보이고 어디로도 보내지 않아요.</p></header>\n  <section class=\"card\" id=\"items\" aria-label=\"평가 항목\"></section>\n  <section class=\"card\">\n    <label for=\"good\"><strong>좋았던 점 한 가지</strong></label>\n    <textarea id=\"good\" placeholder=\"예: 목소리가 또렷했어요\"></textarea>\n    <label for=\"more\"><strong>더 좋아질 점 한 가지 (부드럽게!)</strong></label>\n    <textarea id=\"more\" placeholder=\"예: 사진이 더 크면 좋겠어요\"></textarea>\n    <button class=\"p\" id=\"make\" type=\"button\">평가 카드 만들기</button>\n    <div id=\"result\" role=\"status\"></div>\n    <p class=\"hint\">친구를 놀리거나 상처 주는 말은 쓰지 않아요. 만든 카드는 발표한 친구에게 직접 보여 주세요.</p>\n  </section>\n</div>\n<script>\n  const items = ['내용이 알기 쉬웠어요', '목소리가 또렷했어요', '자료(그림·글)가 보기 좋았어요', '시간을 잘 지켰어요'];\n  const score = items.map(() => 0);\n  const box = document.getElementById('items');\n  items.forEach((t, k) => {\n    const row = document.createElement('div'); row.className = 'row';\n    const lab = document.createElement('span'); lab.textContent = t;\n    const st = document.createElement('div'); st.className = 'stars'; st.setAttribute('role', 'group'); st.setAttribute('aria-label', t);\n    for (let n = 1; n <= 3; n++) {\n      const b = document.createElement('button'); b.type = 'button'; b.textContent = '⭐'; b.setAttribute('aria-label', `${n}점`);\n      b.onclick = () => { score[k] = score[k] === n ? 0 : n; [...st.children].forEach((c, q) => c.classList.toggle('on', q < score[k])); };\n      st.appendChild(b);\n    }\n    row.append(lab, st); box.appendChild(row);\n  });\n  document.getElementById('make').onclick = () => {\n    const sum = score.reduce((a, b) => a + b, 0), max = items.length * 3;\n    const lines = items.map((t, k) => `${'⭐'.repeat(score[k]) || '－'}  ${t}`);\n    const r = document.getElementById('result');\n    r.textContent = `${lines.join('\\n')}\\n\\n합계 ${sum} / ${max}\\n👍 ${document.getElementById('good').value.trim() || '(쓰지 않았어요)'}\\n🌱 ${document.getElementById('more').value.trim() || '(쓰지 않았어요)'}`;\n    r.style.display = 'block';\n  };\n</script>\n</body>\n</html>\n"
  }
