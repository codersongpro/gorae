    {
      "id": "sample-csv-summary",
      "title": "설문 CSV 응답 집계기",
      "type": "html",
      "artifactType": "html",
      "domain": "work",
      "category": "automation",
      "subcategory": "spreadsheet",
      "audience": [
        "teacher",
        "admin"
      ],
      "tags": [
        "자동화",
        "설문",
        "통계"
      ],
      "description": "설문 결과 CSV를 붙여 넣으면 문항별 응답 수를 세어 줘요. 데이터는 밖으로 나가지 않아요.",
      "author": "물결 고래 · 중등",
      "howToUse": "CSV 내용을 붙여 넣고 집계를 누르세요. 첫 줄은 문항 이름이어야 해요.",
      "promptRecipe": "CSV를 붙여 넣으면 열마다 값별 개수를 표로 보여 주는 집계 도구를 만들어 줘. 외부 전송 없이.",
      "version": 1,
      "addedAt": "2026-09-12T00:00:00Z",
      "html": "<!doctype html><html lang=\"ko\"><meta charset=\"utf-8\"><title>CSV 집계</title><body style=\"font-family:sans-serif;padding:12px\"><textarea id=\"c\" rows=\"6\" cols=\"40\" aria-label=\"CSV\"></textarea><br><button id=\"b\">집계</button><pre id=\"o\"></pre><script>document.getElementById(\"b\").onclick=()=>{const rows=document.getElementById(\"c\").value.trim().split(/\\n/).map(r=>r.split(\",\"));const head=rows.shift()||[];document.getElementById(\"o\").textContent=head.map((h,i)=>{const n={};rows.forEach(r=>{const v=(r[i]||\"\").trim();n[v]=(n[v]||0)+1});return h+\": \"+Object.entries(n).map(([k,v])=>k+\" \"+v).join(\", \")}).join(\"\\n\")}</script></body></html>",
