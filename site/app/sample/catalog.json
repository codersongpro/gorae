    {
      "type": "html",
      "artifactType": "html",
      "domain": "lesson",
      "category": "classroom_tool",
      "author": "고래곳간 · 기본 도구",
      "version": 1,
      "addedAt": "2026-10-01T03:02:00.000Z",
      "id": "tool-vote",
      "title": "찬반 의견 모으기",
      "subcategory": "opinion",
      "audience": [
        "teacher",
        "student"
      ],
      "groupType": "whole_class",
      "estimatedMinutes": 10,
      "tags": [
        "토론",
        "투표",
        "전체활동"
      ],
      "description": "질문을 띄우고 찬성·반대·모르겠어요를 눌러 바로 결과 막대로 보여 줘요. 결과 가리기도 돼요.",
      "howToUse": "질문을 고쳐 쓰고, 학생이 나와서 버튼을 누르거나 손든 수를 교사가 눌러 세요.",
      "promptRecipe": "토론 수업용 찬반 투표판을 만들어 줘. 질문 입력, 찬성/반대/모르겠어요 큰 버튼, 비율 막대, 한 표 취소, 결과 가리기.",
      "html": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>찬반 의견 모으기</title>\n<style>\n  body { font-family: system-ui, sans-serif; margin: 0; padding: 16px; background: #f4f6f8; color: #1f2328; }\n  h1 { margin: 0 0 8px; font-size: 1.4rem; }\n  #q { width: 100%; box-sizing: border-box; font-size: 1.3rem; padding: 10px; font-weight: 700; }\n  .opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 14px 0; }\n  .opt { border: 0; border-radius: 18px; padding: 18px; color: #fff; font-size: 1.4rem; font-weight: 800; cursor: pointer; }\n  .opt span { display: block; font-size: 3rem; }\n  .bar { height: 28px; display: flex; border-radius: 14px; overflow: hidden; background: #ddd; }\n  .bar div { transition: width 0.3s; }\n  .row { display: flex; gap: 8px; margin-top: 10px; }\n  .sub { font-size: 1rem; padding: 8px 14px; border-radius: 10px; border: 0; background: #dde5ee; cursor: pointer; }\n</style>\n</head>\n<body>\n<h1>🙋 찬반 의견 모으기</h1>\n<input id=\"q\" aria-label=\"질문\" value=\"급식 시간에 음악을 틀어도 될까요?\">\n<div class=\"opts\" id=\"opts\"></div>\n<div class=\"bar\" id=\"bar\" aria-hidden=\"true\"></div>\n<p id=\"sum\"></p>\n<div class=\"row\">\n  <button class=\"sub\" id=\"undo\">한 표 취소</button>\n  <button class=\"sub\" id=\"reset\">처음부터</button>\n  <label><input type=\"checkbox\" id=\"hide\"> 결과 가리기</label>\n</div>\n<script>\n  const O = [{ k: '찬성', c: '#2e7d32', n: 0 }, { k: '반대', c: '#c62828', n: 0 }, { k: '잘 모르겠어요', c: '#6b7480', n: 0 }];\n  const hist = [];\n  function render() {\n    const total = O.reduce((a, o) => a + o.n, 0);\n    const hide = document.getElementById('hide').checked;\n    const opts = document.getElementById('opts'); opts.textContent = '';\n    O.forEach((o, i) => {\n      const b = document.createElement('button'); b.className = 'opt'; b.style.background = o.c;\n      b.innerHTML = '<span></span>'; b.firstChild.textContent = hide ? '?' : o.n; b.append(o.k);\n      b.onclick = () => { o.n++; hist.push(i); render(); };\n      opts.appendChild(b);\n    });\n    const bar = document.getElementById('bar'); bar.textContent = '';\n    if (!hide) O.forEach((o) => { const d = document.createElement('div'); d.style.background = o.c; d.style.width = (total ? (o.n / total) * 100 : 0) + '%'; bar.appendChild(d); });\n    document.getElementById('sum').textContent = '모두 ' + total + '표' + (hide ? ' (결과 가림)' : '');\n  }\n  document.getElementById('undo').onclick = () => { const i = hist.pop(); if (i !== undefined) O[i].n--; render(); };\n  document.getElementById('reset').onclick = () => { O.forEach((o) => (o.n = 0)); hist.length = 0; render(); };\n  document.getElementById('hide').onchange = render;\n  render();\n</script>\n</body>\n</html>\n",
