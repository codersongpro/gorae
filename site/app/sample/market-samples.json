    "payload": "<!--gorae-card {\"type\":\"html\",\"artifactType\":\"html\",\"domain\":\"lesson\",\"version\":2,\"id\":\"share-group-plant\",\"contentType\":\"presentation\",\"title\":\"식물 관찰 기록 발표판\",\"category\":\"presentation\",\"subcategory\":\"inquiry\",\"schoolLevel\":\"elementary\",\"grade\":\"4\",\"subject\":\"과학\",\"area\":\"생명\",\"unit\":\"식물의 한살이\",\"topic\":\"강낭콩 관찰 기록 발표\",\"estimatedMinutes\":25,\"groupType\":\"group\",\"audience\":[\"teacher\",\"student\"],\"tags\":[\"발표\",\"모둠활동\",\"관찰\"],\"author\":\"새싹 고래\",\"description\":\"모둠이 며칠째·모습·키·관찰 내용을 기록해 두면, 시간 순서 카드와 키 막대로 한눈에 발표할 수 있어요.\",\"howToUse\":\"날짜와 모습, 키, 관찰한 내용을 적고 [기록 추가]를 눌러요. 모두 모이면 [발표 화면 켜기]로 크게 보여 주세요.\",\"promptRecipe\":\"4학년 과학 식물의 한살이 관찰 기록을 날짜별 카드로 모아 발표하는 화면을 만들어 줘. 모습은 씨앗, 싹, 잎, 꽃, 열매 중에서 고르고, 키는 막대로 비교해 줘. 사진이나 이름은 넣지 않게 해 줘.\",\"addedAt\":\"2026-10-02T03:30:00Z\",\"updatedAt\":\"2026-10-03T01:30:00Z\"} -->\n<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>식물 관찰 기록 발표판</title>\n<style>\n  :root { --b: #2e7d32; --tx: #1b2e1c; }\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 14px; background: #f1f8e9; color: var(--tx); font: 16px/1.6 \"Pretendard JP\", \"Malgun Gothic\", system-ui, sans-serif; word-break: keep-all; }\n  .wrap { max-width: 980px; margin: 0 auto; display: grid; gap: 12px; }\n  h1 { font-size: 1.3rem; margin: 0; } .sub { margin: 2px 0 0; color: #4d6b4e; font-size: .9rem; }\n  .card { background: #fff; border-radius: 16px; padding: 14px; box-shadow: 0 1px 4px rgba(23,23,23,.1); display: grid; gap: 8px; }\n  input[type=text], textarea, select { width: 100%; font: inherit; padding: 8px 10px; border: 1px solid #c9deca; border-radius: 10px; } textarea { min-height: 64px; }\n  .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n  button { font: inherit; font-weight: 700; min-height: 46px; padding: 0 16px; border: 1px solid #c9deca; border-radius: 12px; background: #fff; color: var(--tx); cursor: pointer; }\n  button.p { background: var(--b); border-color: var(--b); color: #fff; }\n  button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 3px solid #81c784; outline-offset: 2px; }\n  .timeline { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }\n  .day { background: #fff; border-radius: 14px; border-top: 6px solid var(--b); padding: 12px; display: grid; gap: 4px; box-shadow: 0 1px 4px rgba(23,23,23,.1); }\n  .day .stage { font-size: 2.4rem; text-align: center; } .day h3 { margin: 0; font-size: 1rem; color: var(--b); } .day p { margin: 0; }\n  .grow { height: 14px; border-radius: 999px; background: #dcedc8; overflow: hidden; } .grow i { display: block; height: 100%; background: var(--b); }\n  body.present .editor { display: none; } body.present .day { font-size: 1.15rem; }\n  .learn { background: #fff8e1; border-radius: 14px; padding: 12px 16px; border-left: 6px solid #f9a825; }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header><h1>🌱 식물 관찰 기록 발표판</h1><p class=\"sub\">4학년 과학 · 식물의 한살이. 모둠이 날짜별로 관찰한 내용을 모아 한눈에 발표해요. 사진이나 이름은 넣지 않아요.</p></header>\n  <section class=\"card editor\" aria-label=\"기록 입력\">\n    <label for=\"plant\"><strong>관찰한 식물</strong></label><input type=\"text\" id=\"plant\" value=\"강낭콩\">\n    <div class=\"row\"><label>날짜(며칠째) <input type=\"text\" id=\"d\" value=\"1\" size=\"3\" inputmode=\"numeric\"></label>\n      <label>모습 <select id=\"st\"><option value=\"🫘\">씨앗</option><option value=\"🌱\">싹이 터요</option><option value=\"🌿\">잎이 나요</option><option value=\"🌼\">꽃이 펴요</option><option value=\"🫛\">열매가 열려요</option></select></label>\n      <label>키(cm) <input type=\"text\" id=\"h\" value=\"0\" size=\"4\" inputmode=\"decimal\"></label></div>\n    <label for=\"memo\"><strong>관찰한 내용</strong></label><textarea id=\"memo\" placeholder=\"예: 껍질이 갈라지고 하얀 뿌리가 나왔어요.\"></textarea>\n    <div class=\"row\"><button class=\"p\" id=\"add\">기록 추가</button><button id=\"undo\">마지막 기록 지우기</button><button id=\"sample\">예시 채우기</button></div>\n    <label for=\"learn\"><strong>우리 모둠이 알게 된 점</strong></label><textarea id=\"learn\">씨앗에서 싹이 나려면 물과 따뜻한 온도가 필요해요.</textarea>\n  </section>\n  <section aria-label=\"발표\">\n    <div class=\"row\"><h2 id=\"title\" style=\"margin:0;font-size:1.2rem\"></h2><button id=\"pres\" style=\"margin-left:auto\">발표 화면 켜기/끄기</button></div>\n    <div class=\"timeline\" id=\"tl\"></div>\n    <div class=\"learn\" id=\"lr\"></div>\n  </section>\n</div>\n<script>\n  const $ = (id) => document.getElementById(id);\n  let rec = [];\n  function draw() {\n    $('title').textContent = `${$('plant').value.trim() || '식물'} 관찰 기록 (${rec.length}번)`;\n    const tl = $('tl'); tl.textContent = '';\n    const maxH = Math.max(1, ...rec.map((r) => r.h));\n    rec.slice().sort((a, b) => a.d - b.d).forEach((r) => {\n      const d = document.createElement('div'); d.className = 'day';\n      const s = document.createElement('div'); s.className = 'stage'; s.textContent = r.st;\n      const t = document.createElement('h3'); t.textContent = `${r.d}일째 · 키 ${r.h}cm`;\n      const g = document.createElement('div'); g.className = 'grow'; const gi = document.createElement('i'); gi.style.width = `${(r.h / maxH) * 100}%`; g.appendChild(gi);\n      const p = document.createElement('p'); p.textContent = r.memo;\n      d.append(s, t, g, p); tl.appendChild(d);\n    });\n    $('lr').textContent = rec.length ? `💡 알게 된 점: ${$('learn').value.trim()}` : '기록을 추가하면 여기에 모여요.';\n  }\n  $('add').onclick = () => { rec.push({ d: Math.max(0, +$('d').value || 0), st: $('st').value, h: Math.max(0, +$('h').value || 0), memo: $('memo').value.trim() || '(적은 내용 없음)' }); $('memo').value = ''; $('d').value = String((+$('d').value || 0) + 1); draw(); };\n  $('undo').onclick = () => { rec.pop(); draw(); };\n  $('sample').onclick = () => { rec = [{ d: 1, st: '🫘', h: 0, memo: '물에 불린 콩이 두 배로 커졌어요.' }, { d: 4, st: '🌱', h: 2, memo: '뿌리가 먼저 나오고 싹이 올라왔어요.' }, { d: 9, st: '🌿', h: 8, memo: '떡잎이 펴지고 본잎이 나왔어요.' }, { d: 25, st: '🌼', h: 30, memo: '덩굴이 자라 보라색 꽃이 피었어요.' }]; draw(); };\n  $('pres').onclick = () => document.body.classList.toggle('present');\n  $('learn').addEventListener('input', draw); $('plant').addEventListener('input', draw);\n  $('sample').click();\n</script>\n<style>#gorae-use-guide{margin:20px auto;padding:16px;max-width:960px;background:#fff;color:#14324a;border:2px solid #c9ddea;border-radius:14px;font:16px/1.7 system-ui,sans-serif;text-align:left;word-break:keep-all}#gorae-use-guide summary{cursor:pointer;font-weight:700;min-height:44px}#gorae-use-guide li{margin:8px 0}@media print{#gorae-use-guide{break-inside:avoid}}</style><details id=\"gorae-use-guide\"><summary>수업·업무 활용 안내와 확인 질문</summary><p><strong>목표:</strong> 관찰을 시간 순서와 근거로 정리한다.</p><ol><li><strong>준비:</strong> 목표를 읽고 예상과 이유를 먼저 공책에 적으세요.</li><li><strong>활동:</strong> 같은 기준으로 날짜·키·모습을 기록해 그래프와 발표해요.</li><li><strong>확인:</strong> 한 식물의 기록으로 모든 식물의 성장을 단정하지 않아요.</li><li><strong>정리:</strong> 배운 점·근거·어려웠던 점을 공책이나 외부 학습 문서에 정리하고 다시 볼 질문을 고르세요.</li></ol><p>고래곳간 직접 작성 자료입니다. 입력은 이 실행 화면에서만 유지되므로 결과는 별도로 보관하세요. 교과서와 학생 수준에 맞게 교사가 조정하세요.</p></details></body>\n</html>\n"
  }
]