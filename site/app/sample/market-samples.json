    "payload": "<!--gorae-card {\"type\":\"html\",\"artifactType\":\"html\",\"domain\":\"lesson\",\"version\":1,\"id\":\"share-typing\",\"title\":\"한 줄 타자 연습\",\"category\":\"subject_activity\",\"subcategory\":\"practice\",\"schoolLevel\":\"elementary\",\"grade\":\"4\",\"subject\":\"정보\",\"topic\":\"바른 타자 습관\",\"estimatedMinutes\":10,\"groupType\":\"individual\",\"audience\":[\"student\"],\"tags\":[\"연습\",\"코딩\"],\"description\":\"문장을 따라 치면 정확도와 분당 타수를 알려 줘요.\",\"howToUse\":\"위 문장을 따라 치고 엔터를 누르세요.\",\"promptRecipe\":\"한 줄 문장을 따라 치면 정확도와 분당 타수를 보여 주는 타자 연습 앱을 만들어 줘.\",\"addedAt\":\"2026-10-01T00:00:00Z\",\"author\":\"키보드 고래\"} -->\n<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>한 줄 타자 연습</title>\n<style>\n  body { font-family: system-ui, sans-serif; margin: 0; padding: 16px; background: #eef5fb; color: #1f2328; }\n  #target { font-size: 1.6rem; font-weight: 800; background: #fff; border-radius: 12px; padding: 14px; margin: 10px 0; }\n  input { width: 100%; box-sizing: border-box; font-size: 1.4rem; padding: 10px; }\n  #stat { font-size: 1.2rem; margin-top: 10px; }\n</style>\n</head>\n<body>\n<h1>⌨️ 한 줄 타자 연습</h1>\n<div id=\"target\"></div>\n<input id=\"typing\" aria-label=\"따라 치기\" autocomplete=\"off\">\n<p id=\"stat\" aria-live=\"polite\">문장을 따라 치고 엔터를 누르세요.</p>\n<script>\n  const S = ['고래는 바다에서 노래를 불러요', '오늘도 즐겁게 코딩해요', '천천히 정확하게 치는 것이 먼저예요', '친구의 작품에 칭찬을 남겨요'];\n  let i = 0, start = 0;\n  const tgt = document.getElementById('target'), inp = document.getElementById('typing'), stat = document.getElementById('stat');\n  const show = () => { tgt.textContent = S[i % S.length]; inp.value = ''; start = 0; };\n  inp.addEventListener('input', () => { if (!start) start = performance.now(); });\n  inp.addEventListener('keydown', (e) => {\n    if (e.key !== 'Enter' || e.isComposing) return;\n    const goal = S[i % S.length], typed = inp.value;\n    let right = 0; for (let k = 0; k < goal.length; k++) if (typed[k] === goal[k]) right++;\n    const sec = Math.max(1, (performance.now() - start) / 1000);\n    stat.textContent = `정확도 ${Math.round((right / goal.length) * 100)}% · 분당 ${Math.round((typed.length / sec) * 60)}타`;\n    i++; show();\n  });\n  show();\n</script>\n</body>\n</html>\n"
